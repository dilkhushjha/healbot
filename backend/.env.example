# Copy to backend/.env for local development.
# Never commit real secrets. Configure these in your hosting provider instead.

HEALBOT_ENV=local
HEALBOT_JWT_SECRET=replace-with-a-long-random-secret
HEALBOT_JWT_EXPIRE_H=24

# Comma-separated dashboard origins. Add your deployed frontend URL.
HEALBOT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite for local use; use a managed PostgreSQL URL for hosted use).
HEALBOT_DB_URL=sqlite:///./data/healbot_saas.db

# LLM provider: ollama, huggingface, openai, anthropic, or gemini.
HEALBOT_LLM_PROVIDER=huggingface
HEALBOT_LLM_MODEL=
HF_TOKEN=your_huggingface_access_token
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions
HEALBOT_LLM_TIMEOUT=60

# Keep hosted execution conservative; actual Selenium runs need a browser-capable worker.
HEALBOT_WORKERS=1
HEALBOT_MAX_QUEUED=20
HEALBOT_SCRIPT_TIMEOUT=300

HEALBOT_ARTIFACTS=./artifacts
HEALBOT_MEMORY=./memory
