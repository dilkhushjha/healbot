# Healbot API runtime
HEALBOT_PRODUCT_NAME=Healbot
HEALBOT_ENV=local
HEALBOT_API_VERSION=1.0.0

# Comma-separated browser origins allowed to call the API
HEALBOT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HEALBOT_ALLOW_CREDENTIALS=true

# Local SQLite by default. Use PostgreSQL for hosted deployments.
HEALBOT_DB_URL=sqlite:///./data/healbot_saas.db
# HEALBOT_DB_URL=postgresql+psycopg://healbot:password@localhost:5432/healbot

# Worker and queue limits
HEALBOT_WORKERS=8
HEALBOT_MAX_QUEUED=200
HEALBOT_SCRIPT_TIMEOUT=300

# Healing and model settings
HEALBOT_CONFIDENCE=3
HEALBOT_LLM_TIMEOUT=60
HEALBOT_LLM_REVIEW_THRESHOLD=7
HEALBOT_LLM_REVIEW_GENERIC_INTENT=true

# LLM provider. Keep "ollama" locally; switch this value for cloud migration.
# Supported: ollama, openai, openai-compatible, anthropic, gemini
HEALBOT_LLM_PROVIDER=ollama

# Optional cross-provider model override. Leave blank to use provider-specific model below.
HEALBOT_LLM_MODEL=

# Local Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# OpenAI-compatible chat completions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=

# Gemini generateContent API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMINI_MODEL=gemini-2.5-flash

# Vision model remains local for now.
LLAVA_MODEL=llava

# Storage paths. These can later point to mounted cloud volumes.
HEALBOT_ARTIFACTS=./artifacts
HEALBOT_MEMORY=./memory
